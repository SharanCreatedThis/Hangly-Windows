<?xml version="1.0" encoding="utf-8" ?>
<!--
    Creator Studio: import, cut out, shape, preview, save. The macOS Studio's layout and
    flow — a header of actions, then either the drop zone or the three working columns
    (original, one large preview, controls), then a status line — so the two builds are
    the same Studio (PHASE-A-PLAN.md, Creator Studio parity).
-->
<UserControl
    x:Class="Hangly.App.Studio.StudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="OnRedoAccelerator" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAccelerator" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the name, then open, undo, redo, use-on-rope and save. -->
        <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE771;" FontSize="16" />
                <TextBlock x:Name="HeaderName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="OpenButton" AutomationProperties.AutomationId="StudioOpen" AutomationProperties.Name="Open another image" ToolTipService.ToolTip="Open another image (Ctrl+O)" Click="OnOpen">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
            </Button>
            <!-- Drops the image without saving it, back to the empty state. -->
            <Button Grid.Column="2" x:Name="RemoveButton" AutomationProperties.AutomationId="StudioRemove" AutomationProperties.Name="Remove this image" ToolTipService.ToolTip="Remove this image" IsEnabled="False" Click="OnRemove">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" x:Name="UndoButton" AutomationProperties.AutomationId="StudioUndo" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo the last change (Ctrl+Z)" Click="OnUndo">
                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
            </Button>
            <Button Grid.Column="4" x:Name="RedoButton" AutomationProperties.AutomationId="StudioRedo" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo the last undone change (Ctrl+Y)" Click="OnRedo">
                <FontIcon Glyph="&#xE7A6;" FontSize="14" />
            </Button>
            <AppBarSeparator Grid.Column="5" />
            <CheckBox Grid.Column="6" x:Name="UseOnRopeBox" AutomationProperties.AutomationId="StudioUseOnRope" Content="Use on rope" IsChecked="True" MinWidth="0" ToolTipService.ToolTip="Hang it as soon as it is saved" Click="OnUseOnRope" />
            <Button Grid.Column="7" x:Name="SaveButton" AutomationProperties.AutomationId="StudioSave" Content="Save" MinWidth="64" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Save this charm to your library (Ctrl+S)" Click="OnSave" />
        </Grid>

        <!-- The empty state: a large target for a file. -->
        <Grid Grid.Row="1" x:Name="DropZone" Margin="28" Padding="40">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="2" StrokeDashArray="4,3" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="400">
                <FontIcon Glyph="&#xEB9F;" FontSize="44" Opacity="0.6" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Drop an image to make a charm" />
                <TextBlock HorizontalAlignment="Center" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" Text="PNG, JPEG, WebP, HEIC or SVG. The background is removed and the subject found for you. You can also paste an image." />
                <Button x:Name="ChooseButton" HorizontalAlignment="Center" AutomationProperties.AutomationId="StudioChoose" Content="Choose Image…" Click="OnOpen" />
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <muxc:ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="LoadingText" Text="Reading image…" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Original, result, controls. The middle takes whatever the other two do not. -->
        <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="148" MaxWidth="200" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" MinWidth="236" MaxWidth="286" />
            </Grid.ColumnDefinitions>

            <!-- Original: a reference, with nothing to fiddle with. -->
            <StackPanel Grid.Column="0" Padding="14" Spacing="10" Width="186" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="Original" />
                <Border CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image x:Name="SourceImage" Stretch="Uniform" AutomationProperties.AutomationId="StudioOriginal" />
                </Border>
                <TextBlock x:Name="SourceName" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                <TextBlock x:Name="SourceSize" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- One preview at a time, as large as the window allows. -->
            <Grid Grid.Column="1" Padding="14" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <muxc:SelectorBar x:Name="PreviewModes" HorizontalAlignment="Center" AutomationProperties.Name="Which preview to show" SelectionChanged="OnPreviewModeChanged">
                    <muxc:SelectorBarItem x:Name="CutoutMode" Text="Cut-out" Tag="cutout" />
                    <muxc:SelectorBarItem x:Name="CharmMode" Text="Charm" Tag="charm" IsSelected="True" />
                    <muxc:SelectorBarItem x:Name="RopeMode" Text="On the Rope" Tag="rope" />
                </muxc:SelectorBar>
                <Border Grid.Row="1" x:Name="Stage" CornerRadius="12" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border x:Name="CanvasHost" />
                </Border>
                <TextBlock Grid.Row="2" x:Name="PreviewCaption" HorizontalAlignment="Center" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="The charm as the rope will draw it." />
            </Grid>

            <!-- Everything that can be changed about the charm. -->
            <ScrollViewer Grid.Column="2" Width="272" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <StackPanel Padding="14" Spacing="11">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Background" />
                    <muxc:RadioButtons x:Name="RemovalChoice" AutomationProperties.AutomationId="StudioRemoval" AutomationProperties.Name="Background removal method" SelectionChanged="OnRemovalChanged">
                        <x:String>Automatic</x:String>
                        <x:String>Detected subject</x:String>
                        <x:String>Flat background</x:String>
                        <x:String>Keep original</x:String>
                    </muxc:RadioButtons>
                    <StackPanel x:Name="SubjectPickerPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Subject" />
                        <muxc:SelectorBar x:Name="SubjectPicker" AutomationProperties.Name="Which detected subject to keep" SelectionChanged="OnSubjectChanged" />
                    </StackPanel>
                    <StackPanel x:Name="TolerancePanel" Spacing="2" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Tolerance" />
                            <TextBlock x:Name="ToleranceValue" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <Slider x:Name="ToleranceSlider" AutomationProperties.Name="Tolerance" Minimum="8" Maximum="96" StepFrequency="1" ValueChanged="OnToleranceChanged" />
                    </StackPanel>
                    <TextBlock x:Name="RemovalDetail" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                    <MenuFlyoutSeparator />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Charm" />
                    <TextBox x:Name="NameBox" AutomationProperties.AutomationId="StudioName" AutomationProperties.Name="Charm name" MaxLength="40" TextChanged="OnNameChanged" GotFocus="OnNameFocus" LostFocus="OnNameBlur" />

                    <StackPanel Spacing="2">
                        <Grid>
                            <TextBlock Text="Size" />
                            <TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <Slider x:Name="SizeSlider" AutomationProperties.AutomationId="StudioSize" AutomationProperties.Name="Size" Minimum="0.08" Maximum="0.16" StepFrequency="0.005" ValueChanged="OnSizeChanged" />
                        <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="How large it hangs. Nothing to do with how heavy it is." />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <Grid>
                            <TextBlock Text="Weight" />
                            <TextBlock x:Name="WeightValue" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <Slider x:Name="WeightSlider" AutomationProperties.AutomationId="StudioWeight" AutomationProperties.Name="Weight" Minimum="0.5" Maximum="2" StepFrequency="0.05" ValueChanged="OnWeightChanged" />
                        <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="How it swings. It does not change the size." />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <Grid>
                            <TextBlock Text="Fill" />
                            <TextBlock x:Name="FillValue" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <Slider x:Name="FillSlider" AutomationProperties.AutomationId="StudioFill" AutomationProperties.Name="Fill" Minimum="0.70" Maximum="0.98" StepFrequency="0.01" ValueChanged="OnFillChanged" />
                        <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="How much of its square the picture takes. Not size, not weight." />
                    </StackPanel>

                    <StackPanel x:Name="PhysicsPanel" Spacing="6" Visibility="Collapsed">
                        <MenuFlyoutSeparator />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Physics" />
                        <Grid>
                            <TextBlock Text="Mass" />
                            <TextBlock x:Name="MassValue" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Analysed" />
                            <TextBlock x:Name="AnalysedValue" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="Mass comes from how much shape there is, times your weight. Fill does not change it." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status: the subject summary, then processing or an error. -->
        <Grid Grid.Row="2" Height="30" Padding="14,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon x:Name="SummaryIcon" Glyph="&#xE71E;" FontSize="12" Opacity="0.6" Visibility="Collapsed" />
                <TextBlock x:Name="SubjectSummary" AutomationProperties.AutomationId="StudioSummary" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <muxc:ProgressRing x:Name="ProcessingRing" IsActive="False" Width="12" Height="12" />
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StudioStatus" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                <HyperlinkButton x:Name="StatusHelp" Padding="4,0" FontSize="12" Visibility="Collapsed" Click="OnStatusHelp" />
            </StackPanel>
        </Grid>

        <!-- Confirmation after a save, with the two sensible next steps. -->
        <Grid Grid.RowSpan="3" x:Name="SavedOverlay" Visibility="Collapsed" Background="#59000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Spacing="14" CornerRadius="16" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <Image x:Name="SavedImage" Width="120" Height="120" />
                <TextBlock x:Name="SavedTitle" AutomationProperties.AutomationId="StudioSavedTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="SavedOnRope" HorizontalAlignment="Center" Opacity="0.7" Text="It's on the rope now." />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button AutomationProperties.AutomationId="StudioMakeAnother" Content="Make Another" Click="OnMakeAnother" />
                    <Button AutomationProperties.AutomationId="StudioDone" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="OnDone" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
